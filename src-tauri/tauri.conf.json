{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Lite",
  "version": "0.1.0",
  "identifier": "com.pdflite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Lite",
        "width": 860,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": ["acrylic", "mica"],
          "color": [255, 255, 255, 20]
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/gs/"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "targets": ["nsis", "appimage", "deb", "dmg"],
    "icon": ["icons/icon.ico"]
  }
}
