{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Lite",
  "version": "0.1.0",
  "identifier": "com.pdflite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Lite",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage", "deb", "dmg"],
    "icon": []
  }
}
